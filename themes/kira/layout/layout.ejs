<!DOCTYPE html>
<html lang="<%= config.language || 'zh-CN' %>">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="baidu-site-verification" content="codeva-Nz3lCP1sEj" />
		<%- css("css/layout") %>
		<%
		// 根据页面类型计算标题
		var title = page.title;
		if (is_archive()) {
			title = __('archive');
			if (is_month()) {
				title += '：' + page.year + '/' + page.month;
			} else if (is_year()) {
				title += '：' + page.year;
			}
		} else if (is_category()) {
			title = __('count.categories') + '：' + page.category;
		} else if (is_tag()) {
			title = __('count.tags') + '：' + page.tag;
		}
		%>
		<title><% if (title) { %><%= title %> - <% } %><%= config.title %></title>
		<% var seoDescription = page.description || config.description; %>
		<% var canonicalUrl = full_url_for(page.path || ''); if (canonicalUrl.slice(-1) !== '/') canonicalUrl += '/'; %>
		<meta name="description" content="<%= seoDescription %>" />
		<link rel="canonical" href="<%= canonicalUrl %>" />
		<meta property="og:site_name" content="<%= config.title %>" />
		<meta property="og:title" content="<%= title || config.title %>" />
		<meta property="og:type" content="<%= is_post() ? 'article' : 'website' %>" />
		<meta property="og:url" content="<%= canonicalUrl %>" />
		<meta property="og:image" content="<%= page.cover || theme.background.path %>" />
		<meta property="og:description" content="<%= seoDescription %>" />
		<meta name="twitter:card" content="summary_large_image" />
		<link rel="preconnect" href="https://img.0a0.moe" />
		<!-- 基础样式重置与代码高亮配色（自托管） -->
		<%- css("lib/normalize") %>
		<%- css("lib/hljs/atom-one-dark") %>
		<!-- 预置 kiraicon -->
		<%- css("lib/iconfont/iconfont") %>
		<% if (theme.iconlib) { %>
			<%# 图标库为跨域 CSS，同步加载会阻塞每次导航的首绘造成白闪；改为异步（图标区域尺寸固定，仅字形晚一点出现） %>
			<link rel="preconnect" href="https://at.alicdn.com" />
			<link rel="preload" as="style" href="<%= theme.iconlib %>" crossorigin />
			<link
				rel="stylesheet"
				href="<%= theme.iconlib %>"
				media="print"
				onload="this.media='all'"
				crossorigin
			/>
			<noscript>
				<link rel="stylesheet" href="<%= theme.iconlib %>" crossorigin />
			</noscript>
		<% } %>
		<link
			rel="shortcut icon"
			href="<%= theme.favicon.href %>"
			type="<%= theme.favicon.type %>"
		/>
		<% if (theme.customStyles) { %>
			<% theme.customStyles.forEach(function(customCss){ %>
				<%- css(customCss) %>
			<% }) %>
		<% } %>
		<%# 内容页专属样式前置到 head 并行加载（原先由正文模板在 body 中部输出，发现晚、串行下载）。friends 页无灯箱与代码块，排除以免白载 %>
		<% if ((is_post() || is_page()) && page.layout !== 'friends') { %>
		<%- css('css/kira-image') %>
		<% if (theme.copyableCodeblock) { %><%- css('css/kira-code-copy') %><% } %>
		<% } %>
		<% if (page.layout === 'friends') { %><%- css('css/kira-friends') %><% } %>
		<script defer src="<%- url_for('js/main.js') %>"></script>
		<% if (config.search && theme.widgets && theme.widgets.indexOf('search') !== -1) { %>
		<script defer src="<%- url_for('js/kira-search.js') %>"></script>
		<% } %>
	</head>

	<body>
		<div
			class="kira-background"
			style="background-image: url('<%= theme.background.path %>')"
		></div>
		<%- include("components/header") %>
		<div class="kira-body">
			<%- include("components/sidebar") %>
			<div class="kira-content">
				<div id="kira-top-header"></div>
				<div class="kira-main-content">
					<%- body %>
				</div>
			</div>
			<%- include("components/right-column", { post: page }) %>
		</div>
	</body>
</html>
