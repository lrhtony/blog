<% if (theme.waline.active) { %>
    <%# 评论 CSS 异步加载：评论区在正文下方且由 JS 延迟渲染，不值得阻塞任何页面渲染。preconnect 提前建连，加速 CSS 与 JS 模块的首访加载 %>
    <link rel="preconnect" href="https://registry.npmmirror.com" />
    <link rel="preload" as="style" href="<%- theme.cdn.waline.css %>" />
    <link rel="stylesheet" href="<%- theme.cdn.waline.css %>" media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href="<%- theme.cdn.waline.css %>" /></noscript>
    <div id="waline"></div>
    <script type="module">
        import { init } from '<%- theme.cdn.waline.js %>';
        init({
            el: '#waline',
            serverURL: '<%- theme.waline.serverURL %>',
            search: false,
            emoji: [
                <% for (emoji in theme.waline.emojis) { %>
                '<%= theme.waline.emojis[emoji] %>',
                <% } %>
            ],
            lang: '<%= config.language %>',
            requiredMeta: ['nick', 'mail'],
            wordLimit: <%= theme.waline.wordLimit %>,
            imageUploader: false,
            reaction: false,
            recaptchaV3Key: '<%= theme.waline.recaptchaV3Key %>',
            locale: {
                placeholder: '记得留下昵称和邮箱哦~\n评论会人工审核，别急',
            }
        });
    </script>
<% } %>
