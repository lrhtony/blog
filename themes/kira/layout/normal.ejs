<%- partial('components/kira-image') %>
<div class="kira-post">
	<article>
		<%- partial('components/post-cover', { page: page, theme: theme }) %>
		<%- image_auto_lazyload(page.content) %>
	</article>
	<% if (theme.copyableCodeblock) { %>
		<%# 样式由 layout.ejs head 统一加载（css/kira-code-copy） %>
		<script defer src="<%- url_for('js/kira-code-copy.js') %>"></script>
	<% } %>
</div>
