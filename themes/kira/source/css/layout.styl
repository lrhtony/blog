//总布局
@import 'constants.styl';
@import 'kira-ui.styl';

body {
	width: 100%;
	margin: auto !important;
	height: 100vh;
	position: absolute;
	left: 0;
	top: 0;
	// 以下排版基础接管自 mdui 1.x 全局样式（mdui 已移除）
	color: rgba(0, 0, 0, 0.87);
	font-size: 14px;
	font-family: Roboto, Noto, Helvetica, Arial, sans-serif;
	background-color: #fff;
}

@media (min-width: 600px) {
	body {
		font-size: 14.5px;
	}
}

@media (min-width: 1024px) {
	body {
		font-size: 15px;
	}
}

* {
	outline: none;
	-webkit-tap-highlight-color: transparent;

	&::selection {
		background: $color1;
		color: #fff;
		text-shadow: none;
	}
}

::-webkit-scrollbar {
	width: 6px;
}

::-webkit-scrollbar-track {
	background: #fff;
}

::-webkit-scrollbar-thumb {
	background: #e7e7e7;
	-webkit-border-radius: 3px;
}

a {
	text-decoration: none;
}

img::selection {
	background: $krlbgc2;
}

figure.highlight table tbody tr td {
	&.gutter {
		user-select: none;
	}

	&.code pre *::selection {
		background: $color2;
	}
}

.kira-background {
	opacity: 0.2;
	background-size: cover;
	height: 100vh;
	width: 100%;
	position: fixed;
	top: 0;
	left: 0;
	z-index: -1;
}

.kira-header {
	height: 0;
	display: none;
}

.kira-header-placeholder {
	height: 0;
	display: none;
}

#kira-top-header {
	position: absolute;
	width: 100%;
	height: 0;
	left: 0;
	top: -2vh;
}

.kira-body {
	display: flex;
	justify-content: center;
}

.kira-rainbow {
	a:nth-child(7n + 1) {
		background-color: $krlbgc1;
		color: $color1;
	}

	a:nth-child(7n + 2) {
		background-color: $krlbgc2;
		color: $color2;
	}

	a:nth-child(7n + 3) {
		background-color: $krlbgc3;
		color: $color3;
	}

	a:nth-child(7n + 4) {
		background-color: $krlbgc4;
		color: $color4;
	}

	a:nth-child(7n + 5) {
		background-color: $krlbgc5;
		color: $color5;
	}

	a:nth-child(7n + 6) {
		background-color: $krlbgc6;
		color: $color6;
	}

	a:nth-child(7n + 7) {
		background-color: $krlbgc7;
		color: $color7;
	}
}

.kira-rainbow-fill {
	a {
		color: #fff;
	}
}

#waline .wl-emoji {
	height: 40px;
}


// ============================================
// 跨文档视图过渡（Chromium 126+ / 新版浏览器）
// 同源页面切换由"白屏硬切"变为短促交叉淡入淡出，
// 消除打开文章等跨页导航时的闪烁与跳动；不支持的平台自动忽略。
// ============================================
@css {
	@view-transition {
		navigation: auto;
	}

	// 用户偏好减少动效时直接关闭跨文档过渡（跳过快照，回到直接切换）
	@media (prefers-reduced-motion: reduce) {
		@view-transition {
			navigation: none;
		}
	}
}

@import 'article.styl';

@import 'sidebar.styl';
@import 'kira-search.styl';
@import 'content.styl';
@import 'right-column.styl';
@import 'post.styl';
@import 'archive.styl';

@import 'media.styl';
