// 本地搜索（侧边栏搜索小组件）
@import 'constants.styl';

// 嵌套在 .kira-sidebar 下以获得与 sidebar.styl 中
// `.kira-sidebar .kira-widget-wrap` 相同的特异性（overflow/背景等覆盖依赖 import 顺序在后者）
.kira-sidebar {
	.kira-search-widget-wrap {
		// 侧边栏整体 user-select:none，这里恢复搜索区域（输入框与结果文本）的可选中/复制
		user-select: text;
		// 结果面板为绝对定位悬浮层：卡片作为定位锚点，且必须允许溢出（覆盖默认 overflow:hidden）
		position: relative;
		overflow: visible;
		// 紧凑尺寸：用卡片内边距控制，不用子元素外边距（外边距会穿透无内边距的卡片）
		padding: 8px 10px;

		.kira-search-box {
			display: flex;
			align-items: center;
			height: 34px;
			padding: 0 10px;
			border: 1px solid $border-color;
			border-radius: $radius;
			background-color: $bg-light;
			box-sizing: border-box;
			cursor: text;
			transition: $transition-fast;

			.kirafont {
				font-size: 16px;
				color: $text-lighter;
				flex-shrink: 0;
			}
		}

		.kira-search-input {
			flex: 1;
			min-width: 0;
			align-self: stretch;
			border: none;
			outline: none;
			background: transparent;
			padding: 0 6px 0 8px;
			font-size: 14px;
			color: $text-primary;

			&::placeholder {
				color: $text-light;
			}

			// 隐藏 WebKit 原生清除按钮，统一使用自定义按钮
			&::-webkit-search-cancel-button,
			&::-webkit-search-decoration {
				-webkit-appearance: none;
			}

			// iOS Safari：输入框字号小于 16px 聚焦会触发页面自动缩放。
			// pointer:coarse 覆盖 iPad 横屏等宽视口的触屏场景
			@media (max-width: 1000px), (pointer: coarse) {
				font-size: 16px;
			}
		}

		.kira-search-clear {
			display: flex;
			align-items: center;
			justify-content: center;
			width: 20px;
			height: 20px;
			margin: 0;
			padding: 0;
			border: none;
			border-radius: 50%;
			background: transparent;
			color: $text-light;
			cursor: pointer;
			flex-shrink: 0;
			transition: $transition-fast;

			.kirafont {
				font-size: 12px;
			}

			&:hover {
				color: $text-primary;
				background-color: rgba(0, 0, 0, 0.08);
			}

			&:focus-visible {
				outline: 2px solid $color1;
				outline-offset: 1px;
			}

			// 覆盖 display:flex 与 hidden 属性的冲突
			&[hidden] {
				display: none;
			}
		}

		.kira-search-box:focus-within {
			border-color: $color1;
			background-color: #fff;
			box-shadow: 0 0 0.4rem rgba($color1, 0.25);

			.kirafont {
				color: $color1;
			}
		}

		// 悬浮结果面板：绝对定位，展开时不改变卡片高度、不推挤下方组件
		.kira-search-results {
			position: absolute;
			top: calc(100% + 6px);
			left: 0;
			right: 0;
			z-index: 20;
			// 注：不能用 CSS min(320px, 45vh)，stylus 内置 min() 会吞掉它
			max-height: 320px;
			overflow-y: auto;
			padding: 6px;
			background-color: #fff;
			border-radius: $radius;
			box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12);
			// Firefox 下避免 200px 宽的面板出现整宽系统滚动条
			scrollbar-width: thin;
			scrollbar-color: #e7e7e7 #fff;

			&[hidden] {
				display: none;
			}
		}

		.kira-search-item {
			display: block;
			padding: 8px;
			border-radius: 8px;
			transition: $transition-fast;

			&-title {
				font-size: 14px;
				line-height: 1.4;
				// 与侧边栏其他组件列表链接（分类/归档）保持一致
				color: #606266;
				overflow: hidden;
				text-overflow: ellipsis;
				white-space: nowrap;
			}

			&-snippet {
				font-size: 12px;
				line-height: 1.5;
				margin-top: 2px;
				color: $text-light;
				display: -webkit-box;
				-webkit-box-orient: vertical;
				-webkit-line-clamp: 2;
				overflow: hidden;
			}

			&:hover,
			&:focus-visible {
				background-color: rgba(0, 0, 0, 0.08);

				.kira-search-item-title {
					color: $color1;
				}
			}
		}

		.kira-search-key {
			background-color: rgba($color1, 0.18);
			color: $color1;
			border-radius: 2px;
			padding: 0 1px;
		}

		.kira-search-status {
			padding: 12px 8px;
			font-size: 13px;
			color: $text-light;
			text-align: center;
		}

		.kira-search-count {
			padding: 8px 8px 4px;
			font-size: 12px;
			color: $text-light;
			text-align: center;
		}

		// 仅供屏幕阅读器的实时播报区域（视觉隐藏）
		.kira-search-sr {
			position: absolute;
			width: 1px;
			height: 1px;
			margin: -1px;
			padding: 0;
			border: 0;
			clip: rect(0 0 0 0);
			clip-path: inset(50%);
			overflow: hidden;
			white-space: nowrap;
		}
	}
}
